// QWERTY SYM
//
// ╭╌╌╌╌╌┰─────┬─────┬─────┬─────┬─────┰─────┬─────┬─────┬─────┬─────┰╌╌╌╌╌┬╌╌╌╌╌╮
// ┆ ~*~ ┃ ! ‼ │ @ ¥ │ # ∑ │ $ ₹ │ % ‰ ┃ ^ √ │ & ✉ │ * ∞ │ ( „ │ ) “ ┃ _ – ┆ + ± ┆
// ┆ `*` ┃ 1 “ │ 2 ” │ 3 № │ 4 ₽ │ 5 ˚ ┃ 6*^ │ 7 ¿ │ 8 • │ 9 « │ 0 » ┃ - — ┆ = ≠ ┆
// ╰╌╌╌╌╌╂─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┼╌╌╌╌╌┤
//       ┃ Q § │ W   │ E ≈ │ R   │ T ₽ ┃ Y   │ U « │ I ≡ │ O » │ P   ┃ { ‹ ┆ } › ┆
//       ┃   @ │   < │   = │   > │   $ ┃   ^ │   [ │   _ │   ] │   ` ┃ [ “ ┆ ] ” ┆
//       ┠─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┼╌╌╌╌╌┤
//       ┃ A ⌘ │ S ⌥ │ D ⌃ │ F ⇧ │ G ± ┃ H ← │ J ↓ │ K ↑ │ L → │ :   ┃ "*¨ ┆ |   ┆
//       ┃   " │   ( │   - │   ) │   + ┃   % │   { │   ; │   } │ ; ! ┃ '*´ ┆ \ ¦ ┆
// ╭╌╌╌╌╌╂─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┴╌╌╌╌╌╯
// ┆ |   ┃ Z ⊞ │ X × │ C ÷ │ V   │ B ฿ ┃ N   │ M “ │ <   │ > ” │ ?   ┃
// ┆ \ ¦ ┃   \ │   * │   : │   / │   # ┃   ' │   | │ , ~ │ . & │ / ? ┃
// ╰╌╌╌╌╌┸─────┴─────┴─────┴─────┴─────┸─────┴─────┴─────┴─────┴─────┚

partial alphanumeric_keys modifier_keys
xkb_symbols "sym" {
    name[group1]= "QWERTY SYM";
    key.type[group1] = "FOUR_LEVEL";

    // Digits
    key <AE01> {[ 1               , exclam          , U201C           , U203C           ]}; // 1 ! “ ‼
    key <AE02> {[ 2               , at              , U201D           , yen             ]}; // 2 @ ” ¥
    key <AE03> {[ 3               , numbersign      , U2116           , U2211           ]}; // 3 # № ∑
    key <AE04> {[ 4               , dollar          , U20BD           , U20B9           ]}; // 4 $ ₽ ₹
    key <AE05> {[ 5               , percent         , U02DA           , U2030           ]}; // 5 % ˚ ‰
    key <AE06> {[ 6               , asciicircum     , dead_circumflex , radical         ]}; // 6 ^ ^ √
    key <AE07> {[ 7               , ampersand       , questiondown    , U2709           ]}; // 7 & ¿ ✉
    key <AE08> {[ 8               , asterisk        , U2022           , infinity        ]}; // 8 * • ∞
    key <AE09> {[ 9               , parenleft       , guillemotleft   , U201E           ]}; // 9 ( « „
    key <AE10> {[ 0               , parenright      , guillemotright  , U201C           ]}; // 0 ) » “

    // Letters, first row
    key <AD01> {[ q               , Q               , at              , section         ]}; // q Q @ §
    key <AD02> {[ w               , W               , less            , lessthanequal   ]}; // w W < ≤
    key <AD03> {[ e               , E               , equal           , U2248           ]}; // e E = ≈
    key <AD04> {[ r               , R               , greater         , greaterthanequal]}; // r R > ≥
    key <AD05> {[ t               , T               , dollar          , U20BD           ]}; // t T $ ₽
    key <AD06> {[ y               , Y               , asciicircum     , VoidSymbol      ]}; // y Y ^
    key <AD07> {[ u               , U               , bracketleft     , guillemotleft   ]}; // u U [ «
    key <AD08> {[ i               , I               , underscore      , identical       ]}; // i I _ ≡
    key <AD09> {[ o               , O               , bracketright    , guillemotright  ]}; // o O ] »
    key <AD10> {[ p               , P               , grave           , VoidSymbol      ]}; // p P `

    // Letters, second row
    key <AC01> {[ a               , A               , quotedbl        , U2318           ]}; // a A " ⌘
    key <AC02> {[ s               , S               , parenleft       , U2325           ]}; // s S ( ⌥
    key <AC03> {[ d               , D               , minus           , U2303           ]}; // d D - ⌃
    key <AC04> {[ f               , F               , parenright      , U21E7           ]}; // f F ) ⇧
    key <AC05> {[ g               , G               , plus            , plusminus       ]}; // g G + ±
    key <AC06> {[ h               , H               , percent         , leftarrow       ]}; // h H % ←
    key <AC07> {[ j               , J               , braceleft       , downarrow       ]}; // j J { ↓
    key <AC08> {[ k               , K               , semicolon       , uparrow         ]}; // k K ; ↑
    key <AC09> {[ l               , L               , braceright      , rightarrow      ]}; // l L } →
    key <AC10> {[ semicolon       , colon           , exclam          , VoidSymbol      ]}; // ; : !

    // Letters, third row
    key <AB01> {[ z               , Z               , backslash       , U229E           ]}; // z Z \ ⊞
    key <AB02> {[ x               , X               , asterisk        , multiply        ]}; // x X * ×
    key <AB03> {[ c               , C               , colon           , division        ]}; // c C : ÷
    key <AB04> {[ v               , V               , slash           , VoidSymbol      ]}; // v V /
    key <AB05> {[ b               , B               , numbersign      , U0E3F           ]}; // b B # ฿
    key <AB06> {[ n               , N               , apostrophe      , VoidSymbol      ]}; // n N '
    key <AB07> {[ m               , M               , bar             , U201C           ]}; // m M | “
    key <AB08> {[ comma           , less            , asciitilde      , VoidSymbol      ]}; // , < ~
    key <AB09> {[ period          , greater         , ampersand       , U201D           ]}; // . > & ”
    key <AB10> {[ slash           , question        , question        , VoidSymbol      ]}; // / ? ?

    // Pinky keys
    key <AE11> {[ minus           , underscore      , emdash          , endash          ]}; // - _ — –
    key <AE12> {[ equal           , plus            , notequal        , plusminus       ]}; // = + ≠ ±
    key <AE13> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <AD11> {[ bracketleft     , braceleft       , U201C           , U2039           ]}; // [ { “ ‹
    key <AD12> {[ bracketright    , braceright      , U201D           , U203A           ]}; // ] } ” ›
    key <AC11> {[ apostrophe      , quotedbl        , dead_acute      , dead_diaeresis  ]}; // ' " ´ ¨
    key <AB11> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <TLDE> {[ grave           , asciitilde      , dead_grave      , dead_tilde      ]}; // ` ~ ` ~
    key <BKSL> {[ backslash       , bar             , brokenbar       , VoidSymbol      ]}; // \ | ¦
    key <LSGT> {[ backslash       , bar             , brokenbar       , VoidSymbol      ]}; // \ | ¦

    // Space bar
    key <SPCE> {[ space           , space           , space           , space           ]}; //

    include "level3(ralt_switch)"
};
