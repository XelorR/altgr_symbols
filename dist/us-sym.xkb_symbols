// custom QWERTY layout with AltGr symbol layer
//
// ╭╌╌╌╌╌┰─────┬─────┬─────┬─────┬─────┰─────┬─────┬─────┬─────┬─────┰╌╌╌╌╌┬╌╌╌╌╌╮
// ┆ ~*~ ┃ ! ¹ │ @ ² │ # ³ │ $ ⁴ │ % ⁵ ┃ ^   │ &   │ * ∞ │ ( „ │ ) “ ┃ _ – ┆ + ± ┆
// ┆ `*` ┃ 1 “ │ 2 ” │ 3 № │ 4 ₽ │ 5 ˚ ┃ 6*^ │ 7 ‰ │ 8 • │ 9 « │ 0 » ┃ - — ┆ = ≠ ┆
// ╰╌╌╌╌╌╂─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┼╌╌╌╌╌┤
//       ┃ Q § │ W « │ E ≈ │ R » │ T ₽ ┃ Y / │ U 7 │ I 8 │ O 9 │ P - ┃ { ‹ ┆ } › ┆
//       ┃   @ │   < │   = │   > │   $ ┃   ^ │   [ │   _ │   ] │   ` ┃ [ “ ┆ ] ” ┆
//       ┠─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┼╌╌╌╌╌┤
//       ┃ A ⌘ │ S ⌥ │ D ⌃ │ F ⇧ │ G ± ┃ H * │ J 4 │ K 5 │ L 6 │ : + ┃ "*¨ ┆ |   ┆
//       ┃   " │   ( │   - │   ) │   + ┃   % │   { │   ; │   } │ ; ! ┃ '*´ ┆ \ ¦ ┆
// ╭╌╌╌╌╌╂─────┼─────┼─────┼─────┼─────╂─────┼─────┼─────┼─────┼─────╂╌╌╌╌╌┴╌╌╌╌╌╯
// ┆ |   ┃ Z ← │ X ↓ │ C ↑ │ V → │ B ฿ ┃ N 0 │ M 1 │ < 2 │ > 3 │ ? . ┃
// ┆ \ ¦ ┃   \ │   * │   : │   / │   # ┃   ' │   | │ , ~ │ . & │ / ? ┃
// ╰╌╌╌╌╌┸─────┴─────┴─────┴─────┴─────┸─────┴─────┴─────┴─────┴─────┚

partial alphanumeric_keys modifier_keys
xkb_symbols "sym" {
    name[group1]= "custom QWERTY layout with AltGr symbol layer";
    key.type[group1] = "FOUR_LEVEL";

    // Digits
    key <AE01> {[ 1               , exclam          , U201C           , onesuperior     ]}; // 1 ! “ ¹
    key <AE02> {[ 2               , at              , U201D           , twosuperior     ]}; // 2 @ ” ²
    key <AE03> {[ 3               , numbersign      , U2116           , threesuperior   ]}; // 3 # № ³
    key <AE04> {[ 4               , dollar          , U20BD           , U2074           ]}; // 4 $ ₽ ⁴
    key <AE05> {[ 5               , percent         , U02DA           , U2075           ]}; // 5 % ˚ ⁵
    key <AE06> {[ 6               , asciicircum     , dead_circumflex , VoidSymbol      ]}; // 6 ^ ^
    key <AE07> {[ 7               , ampersand       , U2030           , VoidSymbol      ]}; // 7 & ‰
    key <AE08> {[ 8               , asterisk        , U2022           , infinity        ]}; // 8 * • ∞
    key <AE09> {[ 9               , parenleft       , guillemotleft   , U201E           ]}; // 9 ( « „
    key <AE10> {[ 0               , parenright      , guillemotright  , U201C           ]}; // 0 ) » “

    // Letters, first row
    key <AD01> {[ q               , Q               , at              , section         ]}; // q Q @ §
    key <AD02> {[ w               , W               , less            , guillemotleft   ]}; // w W < «
    key <AD03> {[ e               , E               , equal           , U2248           ]}; // e E = ≈
    key <AD04> {[ r               , R               , greater         , guillemotright  ]}; // r R > »
    key <AD05> {[ t               , T               , dollar          , U20BD           ]}; // t T $ ₽
    key <AD06> {[ y               , Y               , asciicircum     , slash           ]}; // y Y ^ /
    key <AD07> {[ u               , U               , bracketleft     , 7               ]}; // u U [ 7
    key <AD08> {[ i               , I               , underscore      , 8               ]}; // i I _ 8
    key <AD09> {[ o               , O               , bracketright    , 9               ]}; // o O ] 9
    key <AD10> {[ p               , P               , grave           , minus           ]}; // p P ` -

    // Letters, second row
    key <AC01> {[ a               , A               , quotedbl        , U2318           ]}; // a A " ⌘
    key <AC02> {[ s               , S               , parenleft       , U2325           ]}; // s S ( ⌥
    key <AC03> {[ d               , D               , minus           , U2303           ]}; // d D - ⌃
    key <AC04> {[ f               , F               , parenright      , U21E7           ]}; // f F ) ⇧
    key <AC05> {[ g               , G               , plus            , plusminus       ]}; // g G + ±
    key <AC06> {[ h               , H               , percent         , asterisk        ]}; // h H % *
    key <AC07> {[ j               , J               , braceleft       , 4               ]}; // j J { 4
    key <AC08> {[ k               , K               , semicolon       , 5               ]}; // k K ; 5
    key <AC09> {[ l               , L               , braceright      , 6               ]}; // l L } 6
    key <AC10> {[ semicolon       , colon           , exclam          , plus            ]}; // ; : ! +

    // Letters, third row
    key <AB01> {[ z               , Z               , backslash       , leftarrow       ]}; // z Z \ ←
    key <AB02> {[ x               , X               , asterisk        , downarrow       ]}; // x X * ↓
    key <AB03> {[ c               , C               , colon           , uparrow         ]}; // c C : ↑
    key <AB04> {[ v               , V               , slash           , rightarrow      ]}; // v V / →
    key <AB05> {[ b               , B               , numbersign      , U0E3F           ]}; // b B # ฿
    key <AB06> {[ n               , N               , apostrophe      , 0               ]}; // n N ' 0
    key <AB07> {[ m               , M               , bar             , 1               ]}; // m M | 1
    key <AB08> {[ comma           , less            , asciitilde      , 2               ]}; // , < ~ 2
    key <AB09> {[ period          , greater         , ampersand       , 3               ]}; // . > & 3
    key <AB10> {[ slash           , question        , question        , period          ]}; // / ? ? .

    // Pinky keys
    key <AE11> {[ minus           , underscore      , emdash          , endash          ]}; // - _ — –
    key <AE12> {[ equal           , plus            , notequal        , plusminus       ]}; // = + ≠ ±
    key <AE13> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <AD11> {[ bracketleft     , braceleft       , U201C           , U2039           ]}; // [ { “ ‹
    key <AD12> {[ bracketright    , braceright      , U201D           , U203A           ]}; // ] } ” ›
    key <AC11> {[ apostrophe      , quotedbl        , dead_acute      , dead_diaeresis  ]}; // ' " ´ ¨
    key <AB11> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <TLDE> {[ grave           , asciitilde      , dead_grave      , dead_tilde      ]}; // ` ~ ` ~
    key <BKSL> {[ backslash       , bar             , brokenbar       , VoidSymbol      ]}; // \ | ¦
    key <LSGT> {[ backslash       , bar             , brokenbar       , VoidSymbol      ]}; // \ | ¦

    // Space bar
    key <SPCE> {[ space           , space           , space           , space           ]}; //

    include "level3(ralt_switch)"
};
// vim: ft=xkb:fdm=indent:ts=4:nowrap
