      <key code="25"  output="«" />
      <key code="29"  output="»" />

      <!-- Letters, first row -->
      <key code="12"  output="@" />
      <key code="13"  action="ad02_x003c" />
      <key code="14"  action="ad03_=" />
      <key code="15"  action="ad04_x003e" />
      <key code="17"  output="$" />
      <key code="16"  output="^" />
      <key code="32"  output="[" />
      <key code="34"  output="_" />
      <key code="31"  output="]" />
      <key code="35"  output="`" />

      <!-- Letters, second row -->
      <key code="0"   output="&#x0022;" />
      <key code="1"   action="ac02_(" />
      <key code="2"   action="ac03_-" />
      <key code="3"   action="ac04_)" />
      <key code="5"   action="ac05_+" />
      <key code="4"   output="%" />
      <key code="38"  output="{" />
      <key code="40"  output=";" />
      <key code="37"  output="}" />
      <key code="41"  output="!" />

      <!-- Letters, third row -->
      <key code="6"   output="\" />
      <key code="7"   output="*" />
      <key code="8"   output=":" />
      <key code="9"   output="/" />
      <key code="11"  output="#" />
      <key code="45"  output="'" />
      <key code="46"  output="|" />
      <key code="43"  output="~" />
      <key code="47"  output="&#x0026;" />
      <key code="44"  output="?" />

      <!-- Pinky keys -->
      <key code="27"  output="—" />
      <key code="24"  output="≠" />
      <key code="33"  output="“" />
      <key code="30"  output="”" />
      <key code="39"  action="dead_acute" />
      <key code="50"  action="dead_grave" />
      <key code="42"  output="¦" />
      <key code="10"  output="¦" />

      <!-- Space bar -->
      <key code="49"  action="spce_x0020" />

      <!-- Other keys -->
      <key code="36"  output="&#x000D;" />
      <key code="48"  output="&#x0009;" />
      <key code="51"  output="&#x0008;" />
      <key code="52"  output="&#x0003;" />
      <key code="53"  output="&#x001B;" />
      <key code="64"  output="&#x0010;" />
      <key code="65"  output="." />
      <key code="66"  output="&#x001D;" />
      <key code="67"  output="*" />
      <key code="69"  output="+" />
      <key code="70"  output="&#x001C;" />
      <key code="71"  output="&#x001B;" />
      <key code="72"  output="&#x001F;" />
      <key code="75"  output="+" />
      <key code="76"  output="&#x0003;" />
      <key code="77"  output="&#x001E;" />
      <key code="78"  output="-" />
      <key code="79"  output="&#x0010;" />
