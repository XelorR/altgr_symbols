    key <AC02> {[ U044B           , U042B           , parenleft       , U2325           ]}; // ы Ы ( ⌥
    key <AC03> {[ U0432           , U0412           , minus           , U2303           ]}; // в В - ⌃
    key <AC04> {[ U0430           , U0410           , parenright      , U21E7           ]}; // а А ) ⇧
    key <AC05> {[ U043F           , U041F           , plus            , plusminus       ]}; // п П + ±
    key <AC06> {[ U0440           , U0420           , percent         , asterisk        ]}; // р Р % *
    key <AC07> {[ U043E           , U041E           , braceleft       , 4               ]}; // о О { 4
