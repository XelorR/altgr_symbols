    key <AB02> {[ U0447           , U0427           , asterisk        , downarrow       ]}; // ч Ч * ↓
    key <AB03> {[ U0441           , U0421           , colon           , uparrow         ]}; // с С : ↑
    key <AB04> {[ U043C           , U041C           , slash           , rightarrow      ]}; // м М / →
    key <AB05> {[ U0438           , U0418           , numbersign      , U0E3F           ]}; // и И # ฿
    key <AB06> {[ U0442           , U0422           , apostrophe      , 0               ]}; // т Т ' 0
    key <AB07> {[ U044C           , U042C           , bar             , 1               ]}; // ь Ь | 1
    key <AB08> {[ U0431           , U0411           , asciitilde      , 2               ]}; // б Б ~ 2
    key <AB09> {[ U044E           , U042E           , ampersand       , 3               ]}; // ю Ю & 3
    key <AB10> {[ period          , comma           , question        , period          ]}; // . , ? .

    // Pinky keys
    key <AE11> {[ minus           , underscore      , emdash          , endash          ]}; // - _ — –
