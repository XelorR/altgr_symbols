    key <BKSL> {[ backslash       , slash           , brokenbar       , VoidSymbol      ]}; // \ / ¦
    key <LSGT> {[ backslash       , bar             , brokenbar       , VoidSymbol      ]}; // \ | ¦

    // Space bar
