partial alphanumeric_keys modifier_keys
xkb_symbols "sym" {
    name[group1]= "ЙЦУКЕНГ SYM";
    key.type[group1] = "FOUR_LEVEL";

    // Digits
    key <AE01> {[ 1               , exclam          , U201C           , U203C           ]}; // 1 ! “ ‼
    key <AE02> {[ 2               , quotedbl        , U201D           , yen             ]}; // 2 " ” ¥
    key <AE03> {[ 3               , numbersign      , U2116           , U2211           ]}; // 3 # № ∑
    key <AE04> {[ 4               , semicolon       , U20BD           , U20B9           ]}; // 4 ; ₽ ₹
    key <AE05> {[ 5               , percent         , U02DA           , U2030           ]}; // 5 % ˚ ‰
    key <AE06> {[ 6               , colon           , dead_circumflex , radical         ]}; // 6 : ^ √
    key <AE07> {[ 7               , question        , U229E           , U2709           ]}; // 7 ? ⊞ ✉
    key <AE08> {[ 8               , asterisk        , U2022           , infinity        ]}; // 8 * • ∞
    key <AE09> {[ 9               , parenleft       , guillemotleft   , U201E           ]}; // 9 ( « „
    key <AE10> {[ 0               , parenright      , guillemotright  , U201C           ]}; // 0 ) » “

    // Letters, first row
    key <AD01> {[ U0439           , U0419           , at              , section         ]}; // й Й @ §
    key <AD02> {[ U0446           , U0426           , less            , lessthanequal   ]}; // ц Ц < ≤
    key <AD03> {[ U0443           , U0423           , equal           , U2248           ]}; // у У = ≈
    key <AD04> {[ U043A           , U041A           , greater         , greaterthanequal]}; // к К > ≥
    key <AD05> {[ U0435           , U0415           , dollar          , U20BD           ]}; // е Е $ ₽
    key <AD06> {[ U043D           , U041D           , asciicircum     , VoidSymbol      ]}; // н Н ^
    key <AD07> {[ U0433           , U0413           , bracketleft     , guillemotleft   ]}; // г Г [ «
    key <AD08> {[ U0448           , U0428           , underscore      , identical       ]}; // ш Ш _ ≡
    key <AD09> {[ U0449           , U0429           , bracketright    , guillemotright  ]}; // щ Щ ] »
    key <AD10> {[ U0437           , U0417           , grave           , VoidSymbol      ]}; // з З `

    // Letters, second row
    key <AC01> {[ U0444           , U0424           , quotedbl        , U2318           ]}; // ф Ф " ⌘
    key <AC02> {[ U044B           , U042B           , parenleft       , U2325           ]}; // ы Ы ( ⌥
    key <AC03> {[ U0432           , U0412           , minus           , U2303           ]}; // в В - ⌃
    key <AC04> {[ U0430           , U0410           , parenright      , U21E7           ]}; // а А ) ⇧
    key <AC05> {[ U043F           , U041F           , plus            , plusminus       ]}; // п П + ±
    key <AC06> {[ U0440           , U0420           , percent         , leftarrow       ]}; // р Р % ←
    key <AC07> {[ U043E           , U041E           , braceleft       , downarrow       ]}; // о О { ↓
    key <AC08> {[ U043B           , U041B           , semicolon       , uparrow         ]}; // л Л ; ↑
    key <AC09> {[ U0434           , U0414           , braceright      , rightarrow      ]}; // д Д } →
    key <AC10> {[ U0436           , U0416           , exclam          , VoidSymbol      ]}; // ж Ж !

    // Letters, third row
    key <AB01> {[ U044F           , U042F           , backslash       , U229E           ]}; // я Я \ ⊞
    key <AB02> {[ U0447           , U0427           , asterisk        , multiply        ]}; // ч Ч * ×
    key <AB03> {[ U0441           , U0421           , colon           , division        ]}; // с С : ÷
    key <AB04> {[ U043C           , U041C           , slash           , VoidSymbol      ]}; // м М /
    key <AB05> {[ U0438           , U0418           , numbersign      , U0E3F           ]}; // и И # ฿
    key <AB06> {[ U0442           , U0422           , apostrophe      , VoidSymbol      ]}; // т Т '
    key <AB07> {[ U044C           , U042C           , bar             , brokenbar       ]}; // ь Ь | ¦
    key <AB08> {[ U0431           , U0411           , asciitilde      , VoidSymbol      ]}; // б Б ~
    key <AB09> {[ U044E           , U042E           , ampersand       , VoidSymbol      ]}; // ю Ю &
    key <AB10> {[ period          , comma           , question        , VoidSymbol      ]}; // . , ?

    // Pinky keys
    key <AE11> {[ minus           , underscore      , emdash          , endash          ]}; // - _ — –
    key <AE12> {[ equal           , plus            , notequal        , plusminus       ]}; // = + ≠ ±
    key <AE13> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <AD11> {[ U0445           , U0425           , U201C           , U2039           ]}; // х Х “ ‹
    key <AD12> {[ U044A           , U042A           , U201D           , U203A           ]}; // ъ Ъ ” ›
    key <AC11> {[ U044D           , U042D           , dead_acute      , dead_diaeresis  ]}; // э Э ´ ¨
    key <AB11> {[ VoidSymbol      , VoidSymbol      , VoidSymbol      , VoidSymbol      ]}; //
    key <TLDE> {[ U0451           , U0401           , dead_grave      , dead_tilde      ]}; // ё Ё ` ~
    key <BKSL> {[ backslash       , slash           , brokenbar       , VoidSymbol      ]}; // \ / ¦
    key <LSGT> {[ backslash       , bar             , brokenbar       , VoidSymbol      ]}; // \ | ¦

    // Space bar
    key <SPCE> {[ space           , space           , space           , space           ]}; //

    include "level3(ralt_switch)"
};
