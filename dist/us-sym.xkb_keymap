    key <AD10> {[ p               , P               , grave           , VoidSymbol      ]}; // p P `

    // Letters, second row
    key <AC01> {[ a               , A               , braceleft       , VoidSymbol      ]}; // a A {
    key <AC02> {[ s               , S               , parenleft       , VoidSymbol      ]}; // s S (
    key <AC03> {[ d               , D               , parenright      , VoidSymbol      ]}; // d D )
